# Single source of truth for the whole workspace. Package-level .gitignore files
# are deliberately absent; patterns here are unanchored so they match at any depth.

# dependencies
node_modules/

# build output
.next/
build/
out/
*.tsbuildinfo
next-env.d.ts

# testing
coverage/

# env files & secrets
.env*
*.pem

# misc
.DS_Store
*.log
.vercel

# Generated by `next dev`
apps/web/AGENTS.md
apps/web/CLAUDE.md

# Prototype scratch data (see branch prototype/place-input)
apps/web/PROTOTYPE-places-wipe-me.sqlite
apps/web/src/app/prototype/place-input/.cache/
